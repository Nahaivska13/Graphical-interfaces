<Window x:Class="Notebook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Notebook"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <!-- Стиль для рожевої кнопки -->
        <Style x:Key="RoundedPinkButton" TargetType="Button">
            <Setter Property="Background" Value="#FF66B2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="20" Padding="10"
                            BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- кнопка для видалення -->
        <Style x:Key="RoundedRedButton" TargetType="Button" BasedOn="{StaticResource RoundedPinkButton}">
            <Setter Property="Background" Value="#FFB2FE7A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF8DFF33"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FF3AFF2E" BlurRadius="15"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFD9FC68" Offset="0.888"/>
                <GradientStop Color="#FFFFC6EB" Offset="0.153"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- для TextBox -->
            <RowDefinition Height="Auto"/>
            <!-- для кнопки додавання запису -->
            <RowDefinition Height="*"/>
            <!-- для ListBox -->
            <RowDefinition Height="Auto"/>
            <!-- для кнопки видалення запису -->
        </Grid.RowDefinitions>

        <!-- Поле введення -->
        <TextBox x:Name="NoteTextBox" FontSize="16"
                 Background="White" Foreground="#FF3385"
                 BorderThickness="0" Padding="10"
                 TextChanged="NoteTextBox_TextChanged" Text="" 
                 Margin="10,10,10,20" Grid.Row="0" HorizontalAlignment="Stretch"/>

        <!-- Кнопка "Додати запис" -->
        <Button Content="Додати новий запис" Command="{Binding AddNoteCommand}"
                Style="{StaticResource RoundedPinkButton}" 
                Grid.Row="1" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center" Width="250" Background="#FFD7FB70" Foreground="#FFFF17D6" FontSize="16" FontFamily="Bahnschrift SemiBold"/>

        <!-- Список записів -->
        <ListBox x:Name="NotesListBox" Grid.Row="2" FontSize="14"
                 ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}"
                 Background="White" Foreground="#FF3385"
                 BorderThickness="2" BorderBrush="#FF66B2"
                 Padding="5" Margin="10" 
                 SelectionChanged="NotesListBox_SelectionChanged" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- Кнопка "Видалити запис" -->
        <Button Content="Видалити запис" Command="{Binding RemoveNoteCommand}"
                Style="{StaticResource RoundedRedButton}" 
                Grid.Row="3" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center" Width="250" Background="#FFFFA3E0" FontFamily="Bahnschrift SemiBold" FontSize="16"/>
    </Grid>
</Window>

